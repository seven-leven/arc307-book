---
// A drawing or photograph with its numbered caption, as in the book: "Figure 3.5.1M" bold in the island's colour,
// then the text. The picture opens large in a dialog (the figure viewer). With no `src` yet it shows a slot.
import Slot from "./Slot.astro";

interface Props {
  num: string; // "3.5.1M"
  caption: string;
  alt?: string; // says what the picture shows, not "map"
  src?: string;
  ratio?: string;
  kind?: "Figure" | "Table";
  draft?: boolean; // a drawing the group has not finalised
}
const { num, caption, alt = "", src, ratio = "3 / 2", kind = "Figure", draft = false } = Astro.props;
const id = `fig-${num.replace(/[^0-9a-z]/gi, "-")}`;
---
<figure class="fig" id={id}>
  {src ? (
    <button type="button" class="open" data-figure-open={`${id}-view`} aria-label={`Open ${kind} ${num} large`}>
      <img src={src} alt={alt} loading="lazy" decoding="async" style={`aspect-ratio:${ratio}`} />
    </button>
  ) : <Slot what={`${kind} ${num}`} note="Picture to come" ratio={ratio} />}
  <figcaption class="t-caption">
    <strong>{kind} {num}</strong> {caption}{draft && <span class="draft"> Draft drawing.</span>}
  </figcaption>
  {src && (
    <dialog id={`${id}-view`} class="viewer" aria-label={`${kind} ${num}`}>
      <button type="button" class="close t-small" data-figure-close>Close</button>
      <img src={src} alt={alt} />
      <p class="t-caption"><strong>{kind} {num}</strong> {caption}</p>
    </dialog>
  )}
</figure>

<style>
  .fig { display: grid; gap: var(--s2); }
  .open { padding: 0; border: 0; background: none; cursor: zoom-in; display: block; width: 100%; }
  .open img { width: 100%; object-fit: cover; }
  strong { color: var(--accent-text); margin-right: 0.6em; }
  .draft { color: var(--grey-dark); font-style: italic; }
  .viewer { border: 0; padding: var(--s4); width: 100vw; height: 100vh; max-width: none; max-height: none; background: var(--paper); }
  .viewer[open] { display: grid; grid-template-rows: auto 1fr auto; gap: var(--s3); }
  .viewer img { width: 100%; height: 100%; object-fit: contain; min-height: 0; }
  .viewer::backdrop { background: var(--paper); }
  .close { justify-self: end; background: none; border: 0; cursor: pointer; padding: var(--s2); color: var(--ink); text-decoration: underline; }
</style>
