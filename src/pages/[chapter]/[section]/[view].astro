---
// A per-island section on its own page: Chapter 02's sections and themes, on one island or as "compare".
// In Chapters 01 and 03 the per-island sections now sit on one long page per island, so their old addresses
// (/masterplan/vision/male/) forward to the section's place on that page (/masterplan/male/#vision).
import SectionLayout from "../../../layouts/SectionLayout.astro";
import SectionBody from "../../../components/SectionBody.astro";
import { bookPages } from "../../../data/content";
import { CHAPTERS, VIEWS, sectionHref, type View } from "../../../data/structure";

export function getStaticPaths() {
  return CHAPTERS.flatMap((chapter) =>
    chapter.sections.filter((s) => !s.shared).flatMap((section) =>
      VIEWS.map((view) => ({
        params: { chapter: chapter.slug, section: section.slug, view },
        props: { chapter, section, view },
      }))
    )
  );
}
const { chapter, section } = Astro.props;
const view = Astro.props.view as View;
if (chapter.long) return Astro.redirect(sectionHref(chapter, section, view));
const claim = bookPages(chapter.slug, section.slug, view)[0]?.claim;
---
<SectionLayout chapter={chapter} section={section} view={view} subtitle={claim && !section.title.toLowerCase().includes(String(claim).toLowerCase()) ? String(claim) : undefined}>
  <SectionBody chapter={chapter} section={section} view={view} />
</SectionLayout>
