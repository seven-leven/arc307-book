---
// One measure, three islands, always in the order Malé, Villimalé, Hulhumalé, in the 300 shades. Each bar carries
// its island's name and value as text, so nothing depends on colour. `values` are numbers on one scale.
import { ISLANDS } from "../data/structure";

interface Props {
  measure: string;
  unit?: string;
  values: [number | null, number | null, number | null];
  max?: number;
  note?: string;
}
const { measure, unit = "", values, max = Math.max(...values.map((v) => v ?? 0)) || 1, note } = Astro.props;
---
<div class="cr">
  <p class="t-subheading">{measure}</p>
  <dl>
    {ISLANDS.map((isl, k) => (
      <div class="row" data-island={isl.key}>
        <dt class="t-caption">{isl.name}</dt>
        <dd>
          <span class="bar" style={`width:${values[k] === null ? 0 : Math.max(1, ((values[k] as number) / max) * 100)}%`}></span>
          <span class="t-caption val">{values[k] === null ? "Not measured" : `${values[k]}${unit}`}</span>
        </dd>
      </div>
    ))}
  </dl>
  {note && <p class="t-caption note">{note}</p>}
</div>

<style>
  .cr { display: grid; gap: var(--s2); }
  .row { display: grid; grid-template-columns: 6.5em 1fr; align-items: center; gap: var(--s2); padding: 3px 0; }
  dt { font-weight: 700; color: var(--accent-text); }
  dd { display: flex; align-items: center; gap: var(--s2); min-width: 0; }
  .bar { height: 14px; background: var(--accent-300); border-radius: 2px; flex: none; max-width: calc(100% - 7em); }
  .val { white-space: nowrap; }
  .note { color: var(--grey-dark); }
</style>
