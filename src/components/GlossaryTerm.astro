---
// A glossary word: dotted underline, and its one-line meaning on hover, tap or keyboard focus. Use it on the first
// appearance on a page only. `lang="dv"` marks a Dhivehi word so screen readers pronounce it as one.
interface Props {
  meaning: string;
  lang?: string;
}
const { meaning, lang } = Astro.props;
const id = `term-${Math.random().toString(36).slice(2, 8)}`;
---
<span class="term" tabindex="0" data-term aria-describedby={id}><span lang={lang}><slot /></span><span class="tip t-caption" role="tooltip" id={id}>{meaning}</span></span>

<style>
  .term { position: relative; text-decoration: underline dotted; text-underline-offset: 0.2em; cursor: help; }
  .tip {
    display: none; position: absolute; left: 0; top: calc(100% + 6px); z-index: 10; width: max-content; max-width: min(18rem, 80vw);
    background: var(--ink); color: var(--paper); padding: var(--s2) 12px; text-decoration: none; font-style: normal; font-weight: 400;
  }
  .term:hover .tip, .term:focus .tip { display: block; }
</style>
