---
// Home is the grid: three island columns, three chapter rows, each cell a link. A reader sees the whole book's
// shape before clicking anything. No cover image with a button.
import Base from "../layouts/Base.astro";
import { CHAPTERS, EXTRA, ISLANDS, SITE, firstIslandPage, sectionHref, url } from "../data/structure";
---
<Base title="Home">
  <div class="frame stack-lg top">
    <header class="stack">
      <div class="hero">
        <div class="stack">
          <p class="t-small">{SITE.credit}</p>
          <h1 class="t-title">{SITE.title}</h1>
          <p class="t-subtitle">{SITE.subtitle}</p>
          <p class="t-body">Malé, Villimalé and Hulhumalé are three islands of one city region, made in three different ways: one grew over centuries, one was resettled, one was planned and built. We read all three with the same method, so that what is true of one can be set against the others.</p>
          <p class="t-subheading">Public life depends on how a place is designed, more than on how dense or how new it is.</p>
        </div>
        <img class="fan" src={url("/fan.svg")} alt="The cover's three triangles: Villimalé in green, Malé in red, Hulhumalé in blue." width="560" height="377" />
      </div>
      <p class="t-caption how"><strong>How to use this site</strong> Pick an island below and stay on it: the island names at the top of every page keep you on the same section and change the island. Compare shows any section for all three, side by side.</p>
    </header>

    <section aria-labelledby="grid-title" class="stack">
      <h2 class="t-small" id="grid-title">The book: three chapters, three islands</h2>
      <div class="hg">
        <div class="hg-head" aria-hidden="true">
          <span></span>
          {ISLANDS.map((i) => <span class="t-heading isl" data-island={i.key}>{i.name}</span>)}
        </div>
        {CHAPTERS.map((ch) => {
          const shared = ch.sections.filter((s) => s.shared);
          const per = ch.sections.filter((s) => !s.shared);
          return (
            <div class="hg-row">
              <div class="hg-ch">
                <a href={url(`/${ch.slug}/`)}><span class="t-number num">{ch.num}</span><span class="t-heading">{ch.title}</span></a>
                <p class="t-caption">{ch.holds}</p>
                <p class="t-caption sh">
                  Shared: {shared.map((s, k) => <>{k > 0 && " · "}<a href={sectionHref(ch, s, "male")}>{s.num} {s.title}</a></>)}
                </p>
              </div>
              {ISLANDS.map((i) => (
                <nav class="cell" data-island={i.key} aria-label={`${i.name}, chapter ${ch.num} ${ch.title}`}>
                  <a class="t-small who" href={firstIslandPage(ch, i.key).href}>{i.name}</a>
                  <ol role="list">
                    {per.map((s) => <li><a href={sectionHref(ch, s, i.key)}><span class="n">{s.num}</span><span>{s.short}</span></a></li>)}
                  </ol>
                </nav>
              ))}
            </div>
          );
        })}
      </div>
    </section>

    <nav class="three" aria-label="More">
      <a class="more" href={url(`/${EXTRA.about.slug}/`)}><span class="t-subheading">About this book</span><span class="t-caption">Introduction, how to read, methodology, acknowledgements</span></a>
      <a class="more" href={url(`/${EXTRA.reflections.slug}/`)}><span class="t-subheading">04 Reflections</span><span class="t-caption">The editor and the three groups look back</span></a>
      <a class="more" href={url(`/${EXTRA.reference.slug}/`)}><span class="t-subheading">Reference</span><span class="t-caption">Glossary, toolkit data, references, figures and tables</span></a>
    </nav>
  </div>
</Base>

<style>
  .top { padding-top: var(--s6); }
  .hero { display: grid; gap: var(--s4) var(--gutter); align-items: center; }
  .fan { width: 100%; max-width: 520px; height: auto; justify-self: center; }
  @media (min-width: 801px) { .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  .how { max-width: var(--measure); color: var(--grey-dark); }
  .how strong { color: var(--ink); margin-right: 0.6em; }
  .hg { display: grid; gap: var(--s3); }
  .hg-head, .hg-row { display: grid; gap: var(--s3) var(--gutter); grid-template-columns: minmax(0, 1fr); }
  .hg-head { display: none; }
  .hg-ch { display: grid; gap: var(--s2); align-content: start; }
  .hg-ch > a { display: flex; align-items: baseline; gap: var(--s3); color: var(--ink); text-decoration: none; }
  .hg-ch > a:hover .t-heading { text-decoration: underline; text-underline-offset: 0.18em; }
  .num { color: var(--grey); }
  .sh { color: var(--grey-dark); }
  .sh a { color: var(--ink); }
  .isl { color: var(--accent); }
  .cell { display: grid; gap: var(--s2); align-content: start; padding: var(--s3); background: var(--accent-pale); border-top: 4px solid var(--accent); }
  .cell a { color: var(--ink); text-decoration: none; }
  .cell a:hover { text-decoration: underline; text-underline-offset: 0.18em; }
  .cell .who { color: var(--accent-dark); }
  .cell ol { display: grid; }
  .cell li a { display: flex; gap: var(--s2); padding: 3px 0; font-size: var(--caption-size); line-height: 1.4; }
  .cell .n { flex: none; width: 2.2em; font-weight: 700; color: var(--accent-dark); font-variant-numeric: tabular-nums; }
  .hg-row { padding-top: var(--s4); border-top: 1px solid var(--rule); }
  .more { display: grid; gap: var(--s1); color: var(--ink); text-decoration: none; padding: var(--s3) 0; border-top: 1px solid var(--rule); }
  .more:hover .t-subheading { text-decoration: underline; text-underline-offset: 0.18em; }
  @media (min-width: 801px) {
    .hg-head, .hg-row { grid-template-columns: minmax(0, 1.25fr) repeat(3, minmax(0, 1fr)); }
    .hg-head { display: grid; }
    .cell .who { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
</style>
