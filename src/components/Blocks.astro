---
// A section as real web content: a list of blocks written by book/export_web_ch03_male.py (in the Book folder).
// Words are text; each drawing is its own picture that opens large. A text block followed by a legend sit side by
// side on a wide screen, as on the book's layer pages.
import { ISLANDS, url } from "../data/structure";

interface Props {
  blocks: any[];
  title: string;
}
const { blocks, title } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
// pair "text" + "legend" into one row
const rows: any[] = [];
for (const b of blocks) {
  const prev = rows[rows.length - 1];
  if (b.t === "legend" && prev?.t === "text") rows[rows.length - 1] = { t: "pair", text: prev, legend: b };
  else rows.push(b);
}
const src = (p: any) => url(`/${p.src}`);
let fig = 0;
---
<div class="blocks">
  {rows.map((b, k) => {
    if (b.t === "lead") return (
      <header class="lead"><p class="t-heading statement">{b.title}</p><p class="t-body">{b.text}</p></header>
    );
    if (b.t === "heading") return <h2 class="t-heading">{b.text}</h2>;
    if (b.t === "figure") {
      const id = `fig-${uid}-${++fig}`;
      const alt = b.alt ?? b.text ?? `Drawing: ${title}`;
      return (
        <figure class:list={["fig", { main: b.main }]}>
          {b.heading && <h2 class={b.main ? "t-heading" : "t-small"}>{b.heading}</h2>}
          <button type="button" class="open" data-figure-open={id} aria-label={`Open ${b.num ? `${b.label} ${b.num}` : "this drawing"} large`}>
            <img src={src(b)} width={b.wpx} height={b.hpx} alt={alt} loading={k === 0 ? "eager" : "lazy"} decoding="async" />
          </button>
          {b.num && <figcaption class="t-caption"><strong>{`${b.label} ${b.num}`}</strong> {b.text}</figcaption>}
          <dialog id={id} class="viewer" aria-label={b.num ? `${b.label} ${b.num}` : title}>
            <button type="button" class="close t-small" data-figure-close>Close</button>
            <div class="pan"><img src={src(b)} alt="" loading="lazy" /></div>
            {b.num && <p class="t-caption"><strong>{`${b.label} ${b.num}`}</strong> {b.text}</p>}
          </dialog>
        </figure>
      );
    }
    if (b.t === "text") return (
      <section class="text">{b.heading && <h2 class="t-small">{b.heading}</h2>}{b.paras.map((p: string) => <p class="t-body">{p}</p>)}</section>
    );
    if (b.t === "pair") return (
      <div class="pair">
        <section class="text"><h2 class="t-small">{b.text.heading}</h2>{b.text.paras.map((p: string) => <p class="t-body">{p}</p>)}</section>
        <section class="legend">
          <h2 class="t-small">{b.legend.heading}</h2>
          <ul role="list">
            {b.legend.rows.map((r: any) => (
              <li class="t-caption"><span class="sym">{r.sym && <img src={src(r.sym)} width={r.sym.w} height={r.sym.h} alt="" loading="lazy" />}</span><span>{r.text}</span></li>
            ))}
          </ul>
        </section>
      </div>
    );
    if (b.t === "cards") return (
      <section class="stack">
        {b.heading && <h2 class="t-small">{b.heading}</h2>}
        <ul role="list" class:list={["cards", { small: b.small }]} style={`--n:${b.cols}`}>
          {b.cards.map((c: any) => (
            <li class="card">
              {c.pic && <img class="pic" src={src(c.pic)} width={c.pic.wpx} height={c.pic.hpx} alt={`${c.title}. ${c.text}`} loading="lazy" decoding="async" />}
              <h3 class="t-subheading ct">
                {c.n && <span class="badge" aria-hidden="true">{c.n}</span>}
                {c.icon && <img class="icon" src={src(c.icon)} width={c.icon.w} height={c.icon.h} alt="" loading="lazy" />}
                <span>{c.title}</span>
              </h3>
              {c.text && <p class="t-caption">{c.text}</p>}
            </li>
          ))}
        </ul>
      </section>
    );
    if (b.t === "steps") return (
      <ol role="list" class="steps">
        {b.steps.map((s: any) => (
          <li class="step">
            <img src={src(s.pic)} width={s.pic.wpx} height={s.pic.hpx} alt={`Diagram: ${s.title}`} loading="lazy" decoding="async" />
            <div class="stack-s">
              <h3 class="t-subheading ct"><span class="badge" aria-hidden="true">{s.n}</span><span>{s.title}</span></h3>
              <p class="t-small">{s.kicker}</p>
              <p class="t-body">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    );
    if (b.t === "figures") return (
      <section class="stack">
        <h2 class="t-small">{b.heading}</h2>
        <div class="cards" style={`--n:${b.cols}`}>
          {b.figures.map((f: any) => (
            <figure class="fig">
              <img src={src(f.pic)} width={f.pic.wpx} height={f.pic.hpx} alt={f.text} loading="lazy" decoding="async" />
              <figcaption class="t-caption"><strong>{`${f.label} ${f.num}`}</strong> {f.text}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    );
    if (b.t === "caption") return <p class="t-caption cap"><strong>{`${b.label} ${b.num}`}</strong> {b.text}</p>;
    if (b.t === "note") return <p class="t-caption note">{b.text}</p>;
    if (b.t === "keyfigures") return (
      <section class="stack">
        <h2 class={b.small ? "t-small" : "t-heading"}>{b.heading}</h2>
        <div class="cards" style="--n:3">
          {b.items.map((i: any) => (
            <div class="kf">
              {i.heading && <p class="t-small">{i.heading}</p>}
              <p class="t-number">{i.value}{i.unit && <span class="unit"> {i.unit}</span>}</p>
              {i.note && <p class="t-caption">{i.note}</p>}
            </div>
          ))}
        </div>
      </section>
    );
    if (b.t === "table") return (
      <div class="scroll" tabindex="0" role="region" aria-label={`Table ${b.num}`}>
        <table>
          <caption class="t-caption"><strong>{`Table ${b.num}`}</strong> {b.caption}</caption>
          <thead><tr>{b.head.map((h: string) => <th scope="col" class="t-small">{h}</th>)}</tr></thead>
          <tbody>
            {b.rows.map((r: string[]) => (
              <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td class:list={{ strong: i === b.strong }}>{c}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    );
    if (b.t === "steplist") return (
      <section class="stack">
        <h2 class="t-small">{b.heading}</h2>
        {b.intro && <p class="t-caption note">{b.intro}</p>}
        <ol role="list" class="steplist">
          {b.steps.map((s: any) => (
            <li>
              <span class="sw">{s.sym && <img src={src(s.sym)} width={s.sym.w} height={s.sym.h} alt="" loading="lazy" />}</span>
              <span class="t-subheading sn">{s.num ?? ""}</span>
              <span><span class="t-subheading">{s.title}</span><span class="t-caption sd">{s.text}</span></span>
            </li>
          ))}
        </ol>
      </section>
    );
    if (b.t === "toolkits") return (
      <div class="cards tk" style="--n:3">
        {b.cols.map((c: any) => (
          <section class="tkcol" data-island={c.island}>
            <h2 class="t-small"><span class="accent-text">{c.group}</span></h2>
            <p class="t-body tksrc"><em>{c.source}</em></p>
            <p class="t-caption">{c.author}</p>
            {c.kits.map((k: any) => (
              <article class="kit">
                <p class="t-small ktag"><span class="badge">{k.n}</span><span class="accent-text">{`Toolkit ${k.n} · ${k.tag}`}</span></p>
                <h3 class="t-subheading">{k.title}</h3>
                <p class="t-caption">{k.text}</p>
                <p class="t-caption surv">Surveyed, {k.surveyed}:</p>
                <dl class="counts">
                  {k.counts.map((x: any) => (
                    <div data-island={x.island}><dd class="t-heading cv">{x.value}</dd><dt class="t-caption">{ISLANDS.find((i) => i.key === x.island)?.name}</dt></div>
                  ))}
                </dl>
              </article>
            ))}
          </section>
        ))}
      </div>
    );
    if (b.t === "matrix") return (
      <div class="scroll" tabindex="0" role="region" aria-label="Which toolkits each theme reads">
        <table class="matrix">
          <caption class="visually-hidden">Which toolkits each theme reads</caption>
          <thead>
            <tr>
              <th scope="col" class="t-small">Theme</th>
              {b.toolkits.map((k: any) => (
                <th scope="col" data-island={k.island}><span class="badge">{k.n}</span><span class="t-caption tkname">{k.name}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {b.rows.map((r: any) => (
              <tr>
                <th scope="row"><span class="t-number mn">{r.n}</span><span><span class="t-subheading">{r.title}</span><span class="t-caption sd">{r.note}</span></span></th>
                {r.used.map((u: boolean, k: number) => (
                  <td data-island={b.toolkits[k].island}>{u ? <span class="dot on"><span class="visually-hidden">uses toolkit {k + 1}</span></span> : <span class="dot"><span class="visually-hidden">not used</span></span>}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
        <p class="t-caption key"><span class="dot on"></span> the theme uses this toolkit <span class="dot gap"></span> not used</p>
      </div>
    );
    if (b.t === "run") return (
      <section class="stack">
        <h2 class="t-small">{b.heading}</h2>
        <ol role="list" class="cards" style="--n:4">
          {b.steps.map((s: any) => (
            <li class="runstep" data-island={s.island ?? undefined}>
              <span class="t-heading rn">{s.n}</span>
              <span><span class="t-body strongb">{s.label}</span><span class="t-caption sd">{s.text}</span></span>
            </li>
          ))}
        </ol>
      </section>
    );
    if (b.t === "list") return (
      <section class="stack">
        <h2 class={b.small ? "t-small" : "t-heading"}>{b.heading}</h2>
        <div class="groups">
          {b.groups.map((g: any) => (
            <div class="group">
              {g.heading && <h3 class="t-small">{g.heading}</h3>}
              {g.pic && <img src={src(g.pic)} width={g.pic.wpx} height={g.pic.hpx} alt="Key map: where the masterplan area sits on Malé." loading="lazy" />}
              {g.items && <ul role="list">{g.items.map((i: any) => (
                <li class="t-caption"><span class="sym">{i.sym ? <img src={src(i.sym)} width={i.sym.w} height={i.sym.h} alt="" loading="lazy" /> : i.n ? <span class="badge">{i.n}</span> : null}</span><span>{i.text}</span></li>
              ))}</ul>}
            </div>
          ))}
        </div>
      </section>
    );
    return null;
  })}
</div>

<style>
  .blocks { display: grid; gap: var(--s6); }
  .stack { display: grid; gap: var(--s3); }
  .stack-s { display: grid; gap: var(--s2); align-content: start; }
  strong { color: var(--accent-text); margin-right: 0.6em; }
  .lead { display: grid; gap: var(--s3); }
  .statement { color: var(--accent); font-size: clamp(1.4rem, 3.2vw, 2.1rem); line-height: 1.2; }
  .fig { display: grid; gap: var(--s2); }
  .fig.main img { width: 100%; }
  .open { padding: 0; border: 0; background: none; cursor: zoom-in; display: block; width: 100%; text-align: left; }
  img { max-width: 100%; height: auto; }
  .text { display: grid; gap: var(--s2); align-content: start; }
  .text .t-body + .t-body { margin-top: var(--s2); }
  .pair { display: grid; gap: var(--s5) var(--gutter); }
  .legend { display: grid; gap: var(--s2); align-content: start; }
  .legend ul, .group ul { display: grid; gap: 6px; }
  .legend li, .group li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: var(--s2); align-items: center; }
  .sym { display: flex; justify-content: center; }
  .sym img { max-height: 20px; width: auto; }
  .cards { display: grid; gap: var(--s5) var(--gutter); grid-template-columns: minmax(0, 1fr); }
  .card { display: grid; gap: var(--s2); align-content: start; }
  .pic { width: 100%; }
  .ct { display: flex; gap: var(--s2); align-items: center; }
  .badge { flex: none; width: 1.5em; height: 1.5em; border-radius: 50%; background: var(--accent-pale); color: var(--accent-dark); font-size: var(--caption-size); display: grid; place-items: center; }
  .icon { flex: none; width: auto; max-height: 40px; max-width: 48px; }
  .small .icon { max-height: 22px; }
  .steps { display: grid; gap: var(--s5); }
  .step { display: grid; gap: var(--s3) var(--gutter); align-items: center; }
  .step img { width: 100%; max-width: 320px; }
  .cap, .note { max-width: var(--measure); }
  .note { color: var(--grey-dark); }
  .kf { display: grid; gap: var(--s1); align-content: start; border-top: 4px solid var(--accent-light); padding-top: var(--s3); }
  .unit { font-size: var(--subheading-size); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; max-width: 760px; font-size: var(--caption-size); }
  caption { text-align: left; padding-bottom: var(--s2); }
  th, td { text-align: left; padding: var(--s2) var(--s3) var(--s2) var(--s2); font-variant-numeric: tabular-nums; }
  tbody th { font-weight: 400; }
  tbody tr:nth-child(odd) { background: var(--panel); }
  td.strong { font-weight: 700; }
  .groups { display: grid; gap: var(--s4) var(--gutter); grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .group { display: grid; gap: var(--s2); align-content: start; }
  .group li { grid-template-columns: 28px minmax(0, 1fr); }
  /* how to read: the steps in each plan */
  .steplist { display: grid; }
  .steplist li { display: grid; grid-template-columns: 44px 3em minmax(0, 1fr); gap: var(--s2); align-items: start; padding: var(--s2) 0; border-top: 1px solid var(--rule); }
  .sw img { max-height: 22px; width: auto; }
  .sn { color: var(--grey-dark); font-variant-numeric: tabular-nums; }
  .sd { display: block; color: var(--grey-dark); margin-top: 2px; }
  /* the toolkit */
  .tkcol { display: grid; gap: var(--s2); align-content: start; border-top: 5px solid var(--accent); padding-top: var(--s3); }
  .tksrc { margin-top: var(--s1); min-height: 3.2em; }   /* two lines, so the three columns stay level */
  .kit { display: grid; gap: var(--s2); align-content: start; margin-top: var(--s4); padding-top: var(--s3); border-top: 1px solid var(--rule); }
  .ktag { display: flex; align-items: center; gap: var(--s2); }
  .surv { color: var(--grey-dark); margin-top: var(--s2); }
  .counts { display: flex; gap: var(--s4); margin: 0; }
  .counts div { display: grid; }
  .cv { color: var(--accent-300, var(--accent)); }
  .counts dt { color: var(--grey-dark); }
  .matrix { border-collapse: collapse; width: 100%; min-width: 640px; }
  .matrix th, .matrix td { padding: var(--s3) var(--s2); text-align: center; vertical-align: middle; font-weight: 400; }
  .matrix thead th { vertical-align: bottom; border-top: 4px solid var(--accent-light); }
  .matrix thead th:first-child { border-top: 0; text-align: left; }
  .matrix tbody th { text-align: left; display: flex; gap: var(--s3); align-items: baseline; }
  .matrix tbody tr { border-top: 1px solid var(--rule); }
  .matrix tbody tr:nth-child(odd) { background: none; }
  .tkname { display: block; margin-top: var(--s1); }
  .mn { color: var(--grey); font-size: var(--heading-size); }
  .dot { display: inline-block; width: 14px; height: 14px; border-radius: 50%; background: var(--panel); vertical-align: middle; }
  .dot.on { background: var(--accent); }
  .dot.gap { margin-left: var(--s4); }
  .key { margin-top: var(--s3); color: var(--grey-dark); }
  .runstep { display: flex; gap: var(--s3); align-items: baseline; border-top: 4px solid var(--accent-light, var(--rule)); padding-top: var(--s3); }
  .rn { color: var(--accent); }
  .strongb { font-weight: 700; display: block; }
  .viewer { border: 0; padding: var(--s3); width: 100vw; height: 100vh; max-width: none; max-height: none; background: var(--paper); }
  .viewer[open] { display: grid; grid-template-rows: auto 1fr auto; gap: var(--s2); }
  .viewer::backdrop { background: var(--paper); }
  .pan { overflow: auto; min-height: 0; display: grid; place-items: start center; }
  .pan img { width: max(100%, 1100px); max-width: none; }
  .close { justify-self: end; background: none; border: 0; cursor: pointer; padding: var(--s2); color: var(--ink); text-decoration: underline; }
  @media (min-width: 641px) {
    .cards { grid-template-columns: repeat(min(var(--n), 2), minmax(0, 1fr)); }
    .step { grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); }
    .step:nth-child(even) img { order: 2; justify-self: end; }
  }
  @media (min-width: 901px) {
    .cards { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
    .pair { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
</style>
