---
// The book's back matter: glossary and abbreviations, references, the lists of figures and tables. The words come
// from the book (src/book/00/, written by book/export_web_matter.py in the Book folder). Toolkit data is not in
// yet: it needs the book's Appendix A.
import Base from "../../layouts/Base.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Slot from "../../components/Slot.astro";
import matter from "../../book/00/matter.json";
import figures from "../../book/00/figures.json";
import { folioHref } from "../../data/content";
import { EXTRA, REFERENCE_PARTS, url } from "../../data/structure";

export function getStaticPaths() {
  return REFERENCE_PARTS.map((part) => ({ params: { part: part.slug }, props: { part } }));
}
const { part } = Astro.props;
const SUBTITLE: Record<string, string> = {
  glossary: "The words this book uses, in plain terms, for readers who are not architects.",
  references: "Where the book's material comes from, and where the book uses it.",
  "figures-and-tables": "Every figure and table by number, with the section it is in.",
  "toolkit-data": "The counts and scores behind Chapter 02, one table per toolkit.",
};
const title = (s: string) => s.charAt(0) + s.slice(1).toLowerCase();
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
/** Web addresses in a reference become links. */
const linked = (s: string) => s.split(/((?:[a-z0-9-]+\.)+(?:com|org|mv)(?:\/[^\s]*)?)/g);
const lists = ["Figure", "Table"].map((kind) => ({ kind, rows: figures.filter((f) => f.kind === kind) }));
---
<Base title={part.title}>
  <div class="frame stack-lg top">
    <SectionHeader label="Reference" title={part.title === "Glossary" ? "Glossary and abbreviations" : part.title} subtitle={SUBTITLE[part.slug]} />

    {part.slug === "glossary" && matter.glossary.map((g) => (
      <section class="stack" id={slug(g.group)}>
        <h2 class="t-small">{title(g.group)}</h2>
        <dl class="terms">
          {g.terms.map((t) => (<div id={slug(t.term)}><dt class="t-subheading">{t.term}</dt><dd class="t-body">{t.meaning}</dd></div>))}
        </dl>
      </section>
    ))}

    {part.slug === "references" && matter.references.map((g) => (
      <section class="stack">
        <h2 class="t-small">{title(g.group)}</h2>
        <dl class="terms">
          {g.terms.map((t) => (
            <div>
              <dt class="t-subheading">{t.term}</dt>
              <dd class="t-body">{linked(t.meaning).map((s, k) => k % 2 ? <a href={`https://${s}`} rel="external">{s} (opens another site)</a> : s)}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}

    {part.slug === "figures-and-tables" && lists.map((l) => (
      <section class="stack">
        <h2 class="t-heading">{l.kind}s</h2>
        <ul role="list" class="figs">
          {l.rows.map((f) => {
            const href = folioHref(f.folio);
            return <li><span class="num">{f.num}</span><span>{href ? <a href={href}>{f.caption}</a> : f.caption}</span></li>;
          })}
        </ul>
      </section>
    ))}

    {part.slug === "toolkit-data" && <Slot what="Toolkit data" note="One table per toolkit, from the book's Appendix A. Readable as tables; not offered as downloads. To come" />}

    <p class="t-caption"><a href={url(`/${EXTRA.reference.slug}/`)}>All reference pages</a></p>
  </div>
</Base>

<style>
  .top { padding-top: var(--s6); }
  .terms { display: grid; gap: var(--s3); max-width: 860px; }
  .terms > div { display: grid; gap: var(--s1) var(--gutter); padding: var(--s2) 0; }
  .terms dd { max-width: none; }
  .terms a { color: var(--ink); }
  @media (min-width: 801px) { .terms > div { grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); } }
  .figs { display: grid; max-width: 860px; }
  .figs li { display: grid; grid-template-columns: 9em minmax(0, 1fr); gap: var(--s3); padding: var(--s2); font-size: var(--caption-size); line-height: 1.45; }
  .figs li:nth-child(odd) { background: var(--panel); }
  .figs a { color: var(--ink); }
  .num { font-weight: 700; font-variant-numeric: tabular-nums; }
</style>
